# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=
# Comma-separated DNS resolvers used by Node for mongodb+srv lookups.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Authentication (used in Phase 2)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Initial admin seed (run manually with npm run seed:admin)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Media uploads (used in Phase 8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
